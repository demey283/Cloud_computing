# Kopieer dit bestand naar .env en vul de geheimen in (.env staat NIET in git).
# InfluxDB 2 - eerste opstart (setup) en toegang voor Node-RED
INFLUXDB_ORG=vives
INFLUXDB_BUCKET=weerstation
INFLUXDB_RETENTION=30d
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=verander-mij-min-8-tekens
INFLUXDB_TOKEN=verander-mij-lange-willekeurige-token
