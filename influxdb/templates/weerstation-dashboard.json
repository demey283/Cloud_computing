              "query": "fout = from(bucket: \"weerstation\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"fouten\" and r._field == \"aantal\")\n  |> group() |> count() |> set(key: \"soort\", value: \"fout\")\nok = from(bucket: \"weerstation\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => (r._measurement == \"temperatuur\" and r._field == \"waarde\") or (r._measurement == \"luchtvochtigheid\" and r._field == \"waarde\") or (r._measurement == \"wind\" and r._field == \"snelheid\") or (r._measurement == \"regen\" and r._field == \"mm_per_uur\"))\n  |> group() |> count() |> set(key: \"soort\", value: \"ok\")\nunion(tables: [fout, ok])\n  |> group()\n  |> pivot(rowKey: [\"_start\"], columnKey: [\"soort\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._start, _value: 100.0 * float(v: r.fout) / float(v: r.fout + r.ok)}))"
            }
