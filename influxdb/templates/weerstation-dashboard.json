            {
              "query": "from(bucket: \"weerstation\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n      (r._measurement == \"temperatuur\" and (r._field == \"gevoelstemperatuur\" or r._field == \"dauwpunt\")) or\n      (r._measurement == \"wind\" and (r._field == \"windrichting\" or r._field == \"beaufort\" or r._field == \"beaufort_omschrijving\")) or\n      (r._measurement == \"regen\" and r._field == \"intensiteit\"))\n  |> last()\n  |> map(fn: (r) => ({\n      volgorde: if r._field == \"gevoelstemperatuur\" then 1 else if r._field == \"dauwpunt\" then 2\n                else if r._field == \"windrichting\" then 3 else if r._field == \"beaufort\" then 4\n                else if r._field == \"beaufort_omschrijving\" then 5 else 6,\n      Grootheid: if r._field == \"gevoelstemperatuur\" then \"Gevoelstemperatuur\"\n                 else if r._field == \"dauwpunt\" then \"Dauwpunt\"\n                 else if r._field == \"windrichting\" then \"Windrichting\"\n                 else if r._field == \"beaufort\" then \"Windkracht\"\n                 else if r._field == \"beaufort_omschrijving\" then \"Wind\"\n                 else \"Neerslag\",\n      Waarde: if r._field == \"gevoelstemperatuur\" or r._field == \"dauwpunt\" then string(v: r._value) + \" °C\"\n              else if r._field == \"beaufort\" then string(v: r._value) + \" Bft\"\n              else string(v: r._value)\n  }))\n  |> group()\n  |> sort(columns: [\"volgorde\"])\n  |> drop(columns: [\"volgorde\"])"
